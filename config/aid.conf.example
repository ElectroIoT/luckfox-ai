# aid-core configuration. Copy to /root/aid/aid.conf ON THE BOARD and edit there.
# Never commit the real file: it holds the HTTP token. Lines are key=value, '#' starts a comment.

# --- video (width <= 2304, height <= 1296 for the SC3336 sensor)
width=1920
height=1080
fps=30
bitrate_kbps=2048
gop=60
jpeg_quality=80
iq_dir=/etc/iqfiles

# --- image controls, 0..255; -1 (or leave out) keeps the ISP's own value
#brightness=128
#contrast=128
#saturation=128
#sharpness=50

# --- network
rtsp_port=554
rtsp_path=/live/0
http_port=8080

# --- HTTP access token (at least 16 characters). With no token the HTTP server listens on
# 127.0.0.1 only. With a token it listens on the network and every request must send
#   Authorization: Bearer <token>     or     ?token=<token>
# Generate one on your PC, for example:  openssl rand -hex 16
http_token=
